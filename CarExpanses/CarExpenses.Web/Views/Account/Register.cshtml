@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<main class="auto-page-container">
    <section class="auto-form-container">
        <header class="auto-form-header">
            <div>
                <p class="auto-kicker">Join the garage</p>
                <h1 class="auto-form-title">Create account</h1>
            </div>
        </header>

        <div class="auto-form-shell">
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger auto-validation-summary"></div>
                <input asp-for="ReturnUrl" type="hidden" />

                <div class="auto-form-grid">
                    <div class="auto-form-group">
                        <label asp-for="Username" class="auto-label"></label>
                        <input asp-for="Username" class="auto-input" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="auto-form-group">
                        <label asp-for="Email" class="auto-label"></label>
                        <input asp-for="Email" class="auto-input" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="auto-form-group">
                        <label asp-for="Password" class="auto-label"></label>
                        <input asp-for="Password" class="auto-input" type="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="auto-form-group">
                        <label asp-for="ConfirmPassword" class="auto-label"></label>
                        <input asp-for="ConfirmPassword" class="auto-input" type="password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <footer class="auto-form-actions">
                    <button type="submit" class="auto-btn auto-btn-accent">Register</button>
                    <a asp-controller="Account" asp-action="Login" class="auto-btn auto-btn-ghost">Back to login</a>
                </footer>
            </form>
        </div>
    </section>
</main>
