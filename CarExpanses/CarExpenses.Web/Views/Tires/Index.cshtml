@model IReadOnlyList<Tire>
@{
    ViewData["Title"] = "Tires";
}

<main class="auto-page-container">
    <header class="auto-page-header auto-page-header-split">
        <div>
            <p class="auto-kicker">Hardware inventory</p>
            <h1 class="auto-title">Tires</h1>
        </div>
        <a asp-action="Create" class="auto-btn auto-btn-accent auto-btn-large">Add New Tire</a>
    </header>

    <div class="auto-search" data-ajax-search data-search-url="@Url.Action("Search")" data-search-target="#tires-list">
        <label class="auto-label" for="tires-search">Search tires</label>
        <div class="auto-search-row">
            <input id="tires-search" type="search" class="auto-input auto-search-input" placeholder="Search by brand, model, or season" data-search-input />
            <button type="button" class="auto-btn auto-btn-ghost auto-search-clear" data-search-clear>Clear</button>
        </div>
        <p class="auto-search-status" data-search-status aria-live="polite"></p>
    </div>

    <div id="tires-list" class="auto-search-results" aria-live="polite">
        @await Html.PartialAsync("_TireList", Model)
    </div>
</main>
