@model ExpenseFormViewModel
@{
    var isCreate = Model.Id == 0;
}

<main class="auto-page-container">
    <nav class="auto-breadcrumb" aria-label="Back navigation">
        <a asp-controller="Expenses" asp-action="Index" class="auto-btn auto-btn-ghost">Back to Expenses</a>
    </nav>

    <section class="auto-form-container">
        <header class="auto-form-header">
            <div>
                <p class="auto-kicker">Expense ledger</p>
                <h1 class="auto-form-title">@(isCreate ? "Add New Expense" : "Edit Expense")</h1>
            </div>
        </header>

        <div class="auto-form-shell">
            <form asp-action="@(isCreate ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger auto-validation-summary"></div>
                <div class="auto-form-grid">
                    <div class="auto-form-group auto-form-group-wide">
                        <label asp-for="CategoryId" class="auto-label"></label>
                        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="auto-input auto-select">
                            <option value="">Select category</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="auto-form-group auto-form-group-wide">
                        <label asp-for="Description" class="auto-label"></label>
                        <textarea asp-for="Description" class="auto-input" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="auto-form-group">
                        <label asp-for="Amount" class="auto-label"></label>
                        <input asp-for="Amount" class="auto-input" type="number" step="0.01" />
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                    <div class="auto-form-group">
                        <label asp-for="Date" class="auto-label"></label>
                        <input asp-for="Date" class="auto-input" type="date" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>
                </div>

                <footer class="auto-form-actions">
                    <button type="submit" class="auto-btn auto-btn-accent">Save Expense</button>
                    <a asp-controller="Expenses" asp-action="Index" class="auto-btn auto-btn-ghost">Cancel</a>
                </footer>
            </form>
        </div>
    </section>
</main>
