@{
    ViewData["Title"] = "Track Your Fleet";
}

<div class="auto-page-container auto-landing-page">
    <section class="auto-landing-hero auto-stagger-item" style="animation-delay: 0.08s;">
        <div class="auto-landing-copy">
            <p class="auto-kicker">Welcome to CarExpenses</p>
            <h1 class="auto-hero-title">Tame your fleet's running costs</h1>
            <p class="auto-landing-description">
                Replace spreadsheets with a single command center for fuel, service, insurance, and every trip in between.
                Keep the full history of every vehicle and see exactly where the budget goes.
            </p>
            <div class="auto-action-group">
                <a asp-controller="Account" asp-action="Register" class="auto-btn auto-btn-primary auto-btn-large">
                    Start Tracking
                </a>
                <a asp-controller="Account" asp-action="Login" class="auto-btn auto-btn-ghost auto-btn-large">
                    I Already Have An Account
                </a>
            </div>
        </div>
        <div class="auto-landing-visual" aria-hidden="true"></div>
    </section>

    <section id="features" class="auto-landing-features auto-stagger-item" style="animation-delay: 0.16s;">
        <header class="auto-landing-header">
            <p class="auto-kicker">Built for busy garages</p>
            <h2 class="auto-title">Every expense, one command center</h2>
        </header>
        <div class="auto-landing-grid">
            <article class="auto-landing-card">
                <h3>Fuel logs</h3>
                <p>Record every fill-up, monitor efficiency, and track rising fuel costs before they bite.</p>
            </article>
            <article class="auto-landing-card">
                <h3>Service history</h3>
                <p>Log maintenance, inspections, and repairs so nothing slips past the next mileage mark.</p>
            </article>
            <article class="auto-landing-card">
                <h3>Insurance and fees</h3>
                <p>Store policy dates and recurring costs alongside each vehicle, ready for quick review.</p>
            </article>
        </div>
    </section>

    <section class="auto-landing-cta auto-stagger-item" style="animation-delay: 0.24s;">
        <div class="auto-landing-cta-copy">
            <p class="auto-kicker">Ready to roll</p>
            <h2 class="auto-title">Create a free account and start tracking today</h2>
            <p class="auto-landing-cta-text">Set up your first car in minutes and keep every cost in one place.</p>
        </div>
        <div class="auto-action-group">
            <a asp-controller="Account" asp-action="Register" class="auto-btn auto-btn-primary auto-btn-large">
                Create Account
            </a>
            <a asp-controller="Account" asp-action="Login" class="auto-btn auto-btn-ghost auto-btn-large">
                Sign In
            </a>
        </div>
    </section>
</div>
