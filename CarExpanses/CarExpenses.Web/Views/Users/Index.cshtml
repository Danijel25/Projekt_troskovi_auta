@model IReadOnlyList<User>
@{
    ViewData["Title"] = "Users";
}

<main class="auto-page-container">
    <header class="auto-page-header auto-page-header-split">
        <div>
            <p class="auto-kicker">Driver profiles</p>
            <h1 class="auto-title">Users</h1>
        </div>
        <a asp-controller="Account" asp-action="Register" class="auto-btn auto-btn-accent auto-btn-large">Register New User</a>
    </header>

    <div class="auto-search" data-ajax-search data-search-url="@Url.Action("Search")" data-search-target="#users-list">
        <label class="auto-label" for="users-search">Search users</label>
        <div class="auto-search-row">
            <input id="users-search" type="search" class="auto-input auto-search-input" placeholder="Search by username or email" data-search-input />
            <button type="button" class="auto-btn auto-btn-ghost auto-search-clear" data-search-clear>Clear</button>
        </div>
        <p class="auto-search-status" data-search-status aria-live="polite"></p>
    </div>

    <div id="users-list" class="auto-search-results" aria-live="polite">
        @await Html.PartialAsync("_UserList", Model)
    </div>
</main>
