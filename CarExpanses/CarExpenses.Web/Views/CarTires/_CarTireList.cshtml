@model IReadOnlyList<CarTire>

<section class="auto-grid" aria-label="Car tire installations">
    @if (Model.Count == 0)
    {
        <p class="auto-empty-state">No tire assignments found.</p>
    }
    else
    {
        foreach (var item in Model)
        {
            <article class="auto-card">
                <div class="auto-card-badge">Car @item.CarId</div>
                <div class="auto-card-content">
                    <h2 class="auto-card-title">Tire <span>@item.TireId</span></h2>
                    <dl class="auto-stats">
                        <dt>Car Id</dt>
                        <dd>@item.CarId</dd>
                        <dt>Installed</dt>
                        <dd>@item.InstalledDate.ToString("yyyy-MM-dd")</dd>
                    </dl>
                </div>
                <footer class="auto-card-actions">
                    <div class="auto-action-group">
                        <a asp-action="Details" asp-route-id="@item.Id" class="auto-btn auto-btn-primary" aria-label="View tire assignment @item.Id">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="auto-btn auto-btn-ghost" aria-label="Edit tire assignment @item.Id">Update</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="auto-btn auto-btn-danger" aria-label="Delete tire assignment @item.Id">Delete</a>
                    </div>
                </footer>
            </article>
        }
    }
</section>
