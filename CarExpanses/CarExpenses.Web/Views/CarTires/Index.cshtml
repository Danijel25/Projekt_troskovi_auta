@model IReadOnlyList<CarTire>
@{
    ViewData["Title"] = "Car Tires";
}

<main class="auto-page-container">
    <header class="auto-page-header auto-page-header-split">
        <div>
            <p class="auto-kicker">Installation records</p>
            <h1 class="auto-title">Car Tires</h1>
        </div>
        <a asp-action="Create" class="auto-btn auto-btn-accent auto-btn-large">Add New Assignment</a>
    </header>

    <div class="auto-search" data-ajax-search data-search-url="@Url.Action("Search")" data-search-target="#car-tires-list">
        <label class="auto-label" for="car-tires-search">Search assignments</label>
        <div class="auto-search-row">
            <input id="car-tires-search" type="search" class="auto-input auto-search-input" placeholder="Search by car, tire, or date" data-search-input />
            <button type="button" class="auto-btn auto-btn-ghost auto-search-clear" data-search-clear>Clear</button>
        </div>
        <p class="auto-search-status" data-search-status aria-live="polite"></p>
    </div>

    <div id="car-tires-list" class="auto-search-results" aria-live="polite">
        @await Html.PartialAsync("_CarTireList", Model)
    </div>
</main>
