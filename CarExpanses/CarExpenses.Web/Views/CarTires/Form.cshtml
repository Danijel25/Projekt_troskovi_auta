@model CarTireFormViewModel
@{
    var isCreate = Model.Id == 0;
    var selectedCarLabel = Model.CarOptions.FirstOrDefault(option => option.Value == Model.CarId.ToString())?.Text ?? string.Empty;
    var selectedCarValue = Model.CarId > 0 ? Model.CarId.ToString() : string.Empty;
    var selectedTireLabel = Model.TireOptions.FirstOrDefault(option => option.Value == Model.TireId.ToString())?.Text ?? string.Empty;
    var selectedTireValue = Model.TireId > 0 ? Model.TireId.ToString() : string.Empty;
    var carLookupUrl = Url.Action("Search", "Lookups", new { source = "cars" }) ?? string.Empty;
    var tireLookupUrl = Url.Action("Search", "Lookups", new { source = "tires" }) ?? string.Empty;
}

<main class="auto-page-container">
    <nav class="auto-breadcrumb" aria-label="Back navigation">
        <a asp-controller="CarTires" asp-action="Index" class="auto-btn auto-btn-ghost">Back to Car Tires</a>
    </nav>

    <section class="auto-form-container">
        <header class="auto-form-header">
            <div>
                <p class="auto-kicker">Installation records</p>
                <h1 class="auto-form-title">@(isCreate ? "Add New Assignment" : "Edit Assignment")</h1>
            </div>
        </header>

        <div class="auto-form-shell">
            <form asp-action="@(isCreate ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger auto-validation-summary"></div>
                <div class="auto-form-grid">
                    <div class="auto-form-group auto-form-group-wide">
                        <label class="auto-label" for="CarId_Display">@Html.DisplayNameFor(model => model.CarId)</label>
                        @await Html.PartialAsync("_AutocompleteDropdown", new AutocompleteDropdownViewModel
                        {
                            InputId = "CarId_Display",
                            HiddenInputId = "CarId",
                            HiddenInputName = "CarId",
                            LookupUrl = carLookupUrl,
                            Placeholder = "Search car",
                            SelectedLabel = selectedCarLabel,
                            SelectedValue = selectedCarValue,
                            MinChars = 1,
                            Limit = 25
                        })
                        <span asp-validation-for="CarId" class="text-danger"></span>
                    </div>
                    <div class="auto-form-group auto-form-group-wide">
                        <label class="auto-label" for="TireId_Display">@Html.DisplayNameFor(model => model.TireId)</label>
                        @await Html.PartialAsync("_AutocompleteDropdown", new AutocompleteDropdownViewModel
                        {
                            InputId = "TireId_Display",
                            HiddenInputId = "TireId",
                            HiddenInputName = "TireId",
                            LookupUrl = tireLookupUrl,
                            Placeholder = "Search tire",
                            SelectedLabel = selectedTireLabel,
                            SelectedValue = selectedTireValue,
                            MinChars = 1,
                            Limit = 25
                        })
                        <span asp-validation-for="TireId" class="text-danger"></span>
                    </div>
                    <div class="auto-form-group">
                        <label asp-for="InstalledDate" class="auto-label"></label>
                        <input asp-for="InstalledDate" class="auto-input" type="date" />
                        <span asp-validation-for="InstalledDate" class="text-danger"></span>
                    </div>
                </div>

                <footer class="auto-form-actions">
                    <button type="submit" class="auto-btn auto-btn-accent">Save Assignment</button>
                    <a asp-controller="CarTires" asp-action="Index" class="auto-btn auto-btn-ghost">Cancel</a>
                </footer>
            </form>
        </div>
    </section>
</main>
