<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CarExpenses</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <partial name="_FlatpickrPartial" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CarExpenses.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="ce-loader-overlay" class="ce-loader-overlay" aria-live="polite" aria-busy="true" aria-label="Loading application">
        <div class="ce-loader-shell">
            <svg id="ce-loader-tire" class="ce-loader-tire" viewBox="0 0 100 100" width="96" height="96" role="img" aria-label="Loading">
                <circle cx="50" cy="50" r="46" fill="#1c1a17" />
                <circle cx="50" cy="50" r="40" fill="#26211c" />
                <circle cx="50" cy="50" r="44" fill="none" stroke="#eca414" stroke-width="3" stroke-dasharray="6 5" />
                <circle cx="50" cy="50" r="28" fill="#fdf8ee" stroke="#1c1a17" stroke-width="3" />
                <circle cx="50" cy="50" r="10" fill="#eca414" stroke="#1c1a17" stroke-width="2" />
                <line x1="50" y1="16" x2="50" y2="32" stroke="#f7f0df" stroke-width="6" stroke-linecap="round" />
                <line x1="50" y1="84" x2="50" y2="68" stroke="#f7f0df" stroke-width="6" stroke-linecap="round" />
                <line x1="16" y1="50" x2="32" y2="50" stroke="#f7f0df" stroke-width="6" stroke-linecap="round" />
                <line x1="84" y1="50" x2="68" y2="50" stroke="#f7f0df" stroke-width="6" stroke-linecap="round" />
            </svg>
            <div class="ce-loader-label">Loading</div>
        </div>
    </div>
    <script src="~/js/loader.js" asp-append-version="true"></script>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">CarExpenses</a>
                <button class="navbar-toggler ce-mobile-nav-btn d-sm-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation menu">
                    <span class="ce-hamburger-box" aria-hidden="true">
                        <span class="ce-hamburger-inner"></span>
                    </span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Cars" asp-action="Index">Cars</a>
                            </li>
                            @if (User.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Users" asp-action="Index">Users</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Tires" asp-action="Index">Tires</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="CarTires" asp-action="Index">Car Tires</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="FuelExpenses" asp-action="Index">Fuel</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ServiceRecords" asp-action="Index">Service</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Insurances" asp-action="Index">Insurances</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ExpenseCategories" asp-action="Index">Categories</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Expenses" asp-action="Index">Expenses</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CarExpenses - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

