@model IReadOnlyList<FuelExpense>
@{
    ViewData["Title"] = "Fuel Expenses";
}

<main class="auto-page-container">
    <header class="auto-page-header auto-page-header-split">
        <div>
            <p class="auto-kicker">Fuel log</p>
            <h1 class="auto-title">Fuel Expenses</h1>
        </div>
        <a asp-action="Create" class="auto-btn auto-btn-accent auto-btn-large">Add New Fuel Expense</a>
    </header>

    <div class="auto-search" data-ajax-search data-search-url="@Url.Action("Search")" data-search-target="#fuel-expenses-list">
        <label class="auto-label" for="fuel-expenses-search">Search fuel expenses</label>
        <div class="auto-search-row">
            <input id="fuel-expenses-search" type="search" class="auto-input auto-search-input" placeholder="Search by car, date, or total" data-search-input />
            <button type="button" class="auto-btn auto-btn-ghost auto-search-clear" data-search-clear>Clear</button>
        </div>
        <p class="auto-search-status" data-search-status aria-live="polite"></p>
    </div>

    <div id="fuel-expenses-list" class="auto-search-results" aria-live="polite">
        @await Html.PartialAsync("_FuelExpenseList", Model)
    </div>
</main>
