@model FuelExpenseFormViewModel
@{
    var isCreate = Model.Id == 0;
}

<main class="auto-page-container">
    <nav class="auto-breadcrumb" aria-label="Back navigation">
        <a asp-controller="FuelExpenses" asp-action="Index" class="auto-btn auto-btn-ghost">Back to Fuel Expenses</a>
    </nav>

    <section class="auto-form-container">
        <header class="auto-form-header">
            <div>
                <p class="auto-kicker">Fuel log</p>
                <h1 class="auto-form-title">@(isCreate ? "Add New Fuel Expense" : "Edit Fuel Expense")</h1>
            </div>
        </header>

        <div class="auto-form-shell">
            <form asp-action="@(isCreate ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger auto-validation-summary"></div>
                <div class="auto-form-grid">
                    <div class="auto-form-group auto-form-group-wide">
                        <label asp-for="CarId" class="auto-label"></label>
                        <select asp-for="CarId" asp-items="Model.CarOptions" class="auto-input auto-select">
                            <option value="">Select car</option>
                        </select>
                        <span asp-validation-for="CarId" class="text-danger"></span>
                    </div>
                    <div class="auto-form-group">
                        <label asp-for="FuelExpenseDate" class="auto-label"></label>
                        <input asp-for="FuelExpenseDate" class="auto-input" type="date" />
                        <span asp-validation-for="FuelExpenseDate" class="text-danger"></span>
                    </div>
                    <div class="auto-form-group">
                        <label asp-for="Kilometars" class="auto-label"></label>
                        <input asp-for="Kilometars" class="auto-input" type="number" />
                        <span asp-validation-for="Kilometars" class="text-danger"></span>
                    </div>
                    <div class="auto-form-group">
                        <label asp-for="Liters" class="auto-label"></label>
                        <input asp-for="Liters" class="auto-input" type="number" step="0.01" />
                        <span asp-validation-for="Liters" class="text-danger"></span>
                    </div>
                    <div class="auto-form-group">
                        <label asp-for="PricePerLiter" class="auto-label"></label>
                        <input asp-for="PricePerLiter" class="auto-input" type="number" step="0.01" />
                        <span asp-validation-for="PricePerLiter" class="text-danger"></span>
                    </div>
                </div>

                <footer class="auto-form-actions">
                    <button type="submit" class="auto-btn auto-btn-accent">Save Fuel Expense</button>
                    <a asp-controller="FuelExpenses" asp-action="Index" class="auto-btn auto-btn-ghost">Cancel</a>
                </footer>
            </form>
        </div>
    </section>
</main>
