@model IReadOnlyList<Insurance>
@{
    ViewData["Title"] = "Insurances";
}

<main class="auto-page-container">
    <header class="auto-page-header auto-page-header-split">
        <div>
            <p class="auto-kicker">Policy records</p>
            <h1 class="auto-title">Insurances</h1>
        </div>
        <a asp-action="Create" class="auto-btn auto-btn-accent auto-btn-large">Add New Insurance</a>
    </header>

    <div class="auto-search" data-ajax-search data-search-url="@Url.Action("Search")" data-search-target="#insurances-list">
        <label class="auto-label" for="insurances-search">Search insurances</label>
        <div class="auto-search-row">
            <input id="insurances-search" type="search" class="auto-input auto-search-input" placeholder="Search by company, type, or date" data-search-input />
            <button type="button" class="auto-btn auto-btn-ghost auto-search-clear" data-search-clear>Clear</button>
        </div>
        <p class="auto-search-status" data-search-status aria-live="polite"></p>
    </div>

    <div id="insurances-list" class="auto-search-results" aria-live="polite">
        @await Html.PartialAsync("_InsuranceList", Model)
    </div>
</main>
