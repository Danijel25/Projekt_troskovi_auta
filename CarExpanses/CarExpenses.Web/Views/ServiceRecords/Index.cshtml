@model IReadOnlyList<ServiceRecord>
@{
    ViewData["Title"] = "Service Records";
}

<main class="auto-page-container">
    <header class="auto-page-header auto-page-header-split">
        <div>
            <p class="auto-kicker">Maintenance log</p>
            <h1 class="auto-title">Service Records</h1>
        </div>
        <a asp-action="Create" class="auto-btn auto-btn-accent auto-btn-large">Add New Service Record</a>
    </header>

    <div class="auto-search" data-ajax-search data-search-url="@Url.Action("Search")" data-search-target="#service-records-list">
        <label class="auto-label" for="service-records-search">Search service records</label>
        <div class="auto-search-row">
            <input id="service-records-search" type="search" class="auto-input auto-search-input" placeholder="Search by service, car, or date" data-search-input />
            <button type="button" class="auto-btn auto-btn-ghost auto-search-clear" data-search-clear>Clear</button>
        </div>
        <p class="auto-search-status" data-search-status aria-live="polite"></p>
    </div>

    <div id="service-records-list" class="auto-search-results" aria-live="polite">
        @await Html.PartialAsync("_ServiceRecordList", Model)
    </div>
</main>
