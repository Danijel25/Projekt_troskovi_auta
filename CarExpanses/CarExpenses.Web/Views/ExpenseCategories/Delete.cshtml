@model ExpenseCategory

<main class="auto-page-container">
    <nav class="auto-breadcrumb" aria-label="Back navigation">
        <a asp-controller="ExpenseCategories" asp-action="Index" class="auto-btn auto-btn-ghost">Back to Categories</a>
    </nav>

    <article class="auto-details-hero auto-card-danger">
        <header class="auto-details-header auto-details-header-danger">
            <div>
                <p class="auto-kicker">Destructive action</p>
                <h1 class="auto-hero-title">Delete @Model.Name?</h1>
            </div>
            <span class="auto-hero-tag">#@Model.Id</span>
        </header>

        <div class="auto-details-body auto-delete-body">
            <section class="auto-data-panel">
                <h2 class="auto-panel-heading">Category summary</h2>
                <dl class="auto-stats auto-stats-compact">
                    <dt>Expenses</dt>
                    <dd>@(Model.Expenses?.Count ?? 0)</dd>
                </dl>
            </section>

            <aside class="auto-action-panel auto-danger-panel">
                <h3 class="auto-panel-heading">Confirm deletion</h3>
                <p class="auto-danger-copy">This will soft-delete the category and related expenses.</p>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="auto-form-actions auto-form-actions-inline">
                    <button type="submit" class="auto-btn auto-btn-danger">Delete Category</button>
                    <a asp-controller="ExpenseCategories" asp-action="Index" class="auto-btn auto-btn-ghost">Cancel</a>
                </form>
            </aside>
        </div>
    </article>
</main>
