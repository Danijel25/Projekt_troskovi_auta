@model IReadOnlyList<ExpenseCategory>
@{
    ViewData["Title"] = "Expense Categories";
}

<main class="auto-page-container">
    <header class="auto-page-header auto-page-header-split">
        <div>
            <p class="auto-kicker">Ledger groups</p>
            <h1 class="auto-title">Expense Categories</h1>
        </div>
        @if (User.IsInRole(AppRoles.Admin))
        {
            <a asp-action="Create" class="auto-btn auto-btn-accent auto-btn-large">Add New Category</a>
        }
    </header>

    <div class="auto-search" data-ajax-search data-search-url="@Url.Action("Search")" data-search-target="#expense-categories-list">
        <label class="auto-label" for="expense-categories-search">Search categories</label>
        <div class="auto-search-row">
            <input id="expense-categories-search" type="search" class="auto-input auto-search-input" placeholder="Search by name or id" data-search-input />
            <button type="button" class="auto-btn auto-btn-ghost auto-search-clear" data-search-clear>Clear</button>
        </div>
        <p class="auto-search-status" data-search-status aria-live="polite"></p>
    </div>

    <div id="expense-categories-list" class="auto-search-results" aria-live="polite">
        @await Html.PartialAsync("_ExpenseCategoryList", Model)
    </div>
</main>
