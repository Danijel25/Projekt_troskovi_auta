@model CarExpenses.Web.Models.CarFormViewModel
@using CarExpenses.Model.Enums

@{
    var selectedUserLabel = Model.UserOptions.FirstOrDefault(option => option.Value == Model.UserId.ToString())?.Text ?? string.Empty;
    var selectedUserValue = Model.UserId > 0 ? Model.UserId.ToString() : string.Empty;
    var userLookupUrl = Url.Action("Search", "Lookups", new { source = "users" }) ?? string.Empty;
}

<section class="auto-form-container">
    <header class="auto-form-header">
        <div>
            <p class="auto-kicker">Vehicle form</p>
            <h1 class="auto-form-title">@ViewData["Title"]</h1>
        </div>
    </header>

    <div class="auto-form-shell">
        <div asp-validation-summary="ModelOnly" class="text-danger auto-validation-summary"></div>

        <div class="auto-form-grid">
            <div class="auto-form-group auto-form-group-wide">
                <label class="auto-label" for="UserId_Display">@Html.DisplayNameFor(model => model.UserId)</label>
                @await Html.PartialAsync("_AutocompleteDropdown", new AutocompleteDropdownViewModel
                {
                    InputId = "UserId_Display",
                    HiddenInputId = "UserId",
                    HiddenInputName = "UserId",
                    LookupUrl = userLookupUrl,
                    Placeholder = "Search owner",
                    SelectedLabel = selectedUserLabel,
                    SelectedValue = selectedUserValue,
                    MinChars = 1,
                    Limit = 25
                })
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>

            <div class="auto-form-group">
                <label asp-for="Brand" class="auto-label"></label>
                <input asp-for="Brand" class="auto-input" />
                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>

            <div class="auto-form-group">
                <label asp-for="Model" class="auto-label"></label>
                <input asp-for="Model" class="auto-input" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>

            <div class="auto-form-group">
                <label asp-for="Year" class="auto-label"></label>
                <input asp-for="Year" class="auto-input" type="number" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>

            <div class="auto-form-group">
                <label asp-for="FuelType" class="auto-label"></label>
                <select asp-for="FuelType" asp-items="Html.GetEnumSelectList<FuelType>()" class="auto-input auto-select"></select>
                <span asp-validation-for="FuelType" class="text-danger"></span>
            </div>

            <div class="auto-form-group">
                <label asp-for="EngineVolume" class="auto-label"></label>
                <input asp-for="EngineVolume" class="auto-input" type="number" step="0.1" />
                <span asp-validation-for="EngineVolume" class="text-danger"></span>
            </div>

            <div class="auto-form-group">
                <label asp-for="CurrentMilage" class="auto-label"></label>
                <input asp-for="CurrentMilage" class="auto-input" type="number" />
                <span asp-validation-for="CurrentMilage" class="text-danger"></span>
            </div>

            <div class="auto-form-group">
                <label asp-for="PurchasePrice" class="auto-label"></label>
                <input asp-for="PurchasePrice" class="auto-input" type="number" step="0.01" />
                <span asp-validation-for="PurchasePrice" class="text-danger"></span>
            </div>

            <div class="auto-form-group">
                <label asp-for="PurchaseDate" class="auto-label"></label>
                <input asp-for="PurchaseDate" class="auto-input" type="date" />
                <span asp-validation-for="PurchaseDate" class="text-danger"></span>
            </div>
        </div>

        <footer class="auto-form-actions">
            <button type="submit" class="auto-btn auto-btn-accent">Save Vehicle</button>
            <a asp-controller="Cars" asp-action="Index" class="auto-btn auto-btn-ghost">Cancel</a>
        </footer>
    </div>
</section>
