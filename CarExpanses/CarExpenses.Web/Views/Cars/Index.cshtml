@model IReadOnlyList<Car>
@{
    ViewData["Title"] = "My Garage";
}

<main class="auto-page-container">
    <header class="auto-page-header auto-page-header-split">
        <div>
            <p class="auto-kicker">Vehicle archive</p>
            <h1 class="auto-title">My Garage</h1>
        </div>
        <a asp-controller="Cars" asp-action="Create" class="auto-btn auto-btn-accent auto-btn-large">
            Add New Vehicle
        </a>
    </header>

    <div class="auto-search" data-ajax-search data-search-url="@Url.Action("Search")" data-search-target="#car-list">
        <label class="auto-label" for="car-search">Search cars</label>
        <div class="auto-search-row">
            <input id="car-search" type="search" class="auto-input auto-search-input" placeholder="Search by brand, model, year, or fuel" data-search-input />
            <button type="button" class="auto-btn auto-btn-ghost auto-search-clear" data-search-clear>Clear</button>
        </div>
        <p class="auto-search-status" data-search-status aria-live="polite"></p>
    </div>

    <div id="car-list" class="auto-search-results" aria-live="polite">
        @await Html.PartialAsync("_CarList", Model)
    </div>
</main>
