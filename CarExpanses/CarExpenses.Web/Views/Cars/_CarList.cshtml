@model IReadOnlyList<Car>

<section class="auto-grid" aria-label="Cars list">
    @if (Model.Count == 0)
    {
        <p class="auto-empty-state">No cars found.</p>
    }
    else
    {
        foreach (var car in Model)
        {
            <article class="auto-card">
                <div class="auto-card-badge">@car.Year</div>
                <div class="auto-card-content">
                    <h2 class="auto-card-title">@car.Brand <span>@car.Model</span></h2>
                    <dl class="auto-stats">
                        <dt>Fuel</dt>
                        <dd>@car.FuelType</dd>
                        <dt>Engine</dt>
                        <dd>@car.EngineVolume L</dd>
                        <dt>Mileage</dt>
                        <dd>@car.CurrentMilage km</dd>
                    </dl>
                </div>
                <footer class="auto-card-actions">
                    <div class="auto-action-group">
                        <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id" class="auto-btn auto-btn-primary"
                           aria-label="View details for @car.Brand @car.Model">
                            Details
                        </a>
                        <a asp-controller="Cars" asp-action="Edit" asp-route-id="@car.Id" class="auto-btn auto-btn-ghost"
                           aria-label="Edit @car.Brand @car.Model">
                            Update
                        </a>
                        <a asp-controller="Cars" asp-action="Delete" asp-route-id="@car.Id" class="auto-btn auto-btn-danger"
                           aria-label="Delete @car.Brand @car.Model">
                            Delete
                        </a>
                    </div>
                </footer>
            </article>
        }
    }
</section>
